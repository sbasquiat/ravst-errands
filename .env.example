# ============================================
# Ravst — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# ---- Supabase ----
# Project URL — Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key — Supabase Dashboard → Settings → API → anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — Supabase Dashboard → Settings → API → service_role key
# Used for admin operations (webhooks, account deletion). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----
# Publishable key — Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key — Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Webhook signing secret — Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=
# Subscription price IDs — Stripe Dashboard → Products → copy price ID
# Starter plan: 5 errands/month
STRIPE_PRICE_STARTER=
# Regular plan: 10 errands/month
STRIPE_PRICE_REGULAR=

# ---- Resend (email) ----
# API key — https://resend.com/api-keys
RESEND_API_KEY=
# From address — must be verified domain in Resend
RESEND_FROM_EMAIL=Ravst <hello@ravst.com>

# ---- App ----
# Public URL (used for OG tags, emails, sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Google Maps ----
# Server-side API key for address autocomplete (Google Places API)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API (Legacy) + Geocoding API
GOOGLE_MAPS_API_KEY=

# ---- Sentry ----
# Error tracking & performance monitoring
# Create project at https://sentry.io → Projects → Create Project → Next.js
NEXT_PUBLIC_SENTRY_DSN=

# ---- Optional ----
# Secret for cron endpoints (offer expiry). Generate a random string.
CRON_SECRET=
